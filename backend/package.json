{
  "name": "autoed-backend-core",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "ts-node-dev --respawn --transpile-only src/index.ts",
    "build": "tsc -p tsconfig.json",
    "start": "node dist/index.js",
    "postinstall": "prisma generate",
    "db:migrate": "prisma migrate deploy",
    "smoke": "node ./dist/scripts/smokeTest.js"
  },
  "dependencies": {
    "express": "^4.18.2",
    "firebase-admin": "^11.10.0",
    "prisma": "^5.10.0",
    "@prisma/client": "^5.10.0",
    "dotenv": "^16.3.1",
    "body-parser": "^1.20.2",
    "node-fetch": "^3.4.2"
  },
  "devDependencies": {
    "ts-node-dev": "^2.0.0",
    "typescript": "^5.9.3",
    "@types/express": "^4.17.17"
  }
}
